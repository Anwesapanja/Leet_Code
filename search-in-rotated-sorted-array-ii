Example 1:

Input: nums = [2,5,6,0,0,1,2], target = 0
Output: true
Example 2:

Input: nums = [2,5,6,0,0,1,2], target = 3
Output: false
-----------------------------------------------
class Solution:
    def search(self, nums: List[int], target: int) -> bool:
        flag=0
        for i in nums:
            if (target==i):
                return True
            else:
                flag=0
        if (flag==0):
            return False
