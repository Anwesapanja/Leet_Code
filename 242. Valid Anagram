Example 1:

Input: s = "anagram", t = "nagaram"

Output: true

Example 2:

Input: s = "rat", t = "car"

Output: false
--------------------------------------------------
class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
        s1=list(s)
        s2=list(t)
        s1.sort()
        s2.sort()
        if(s1==s2):
            return True
        else:
            return False
