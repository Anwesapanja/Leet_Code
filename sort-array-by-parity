Example 1:

Input: nums = [3,1,2,4]
Output: [2,4,3,1]
Explanation: The outputs [4,2,3,1], [2,4,1,3], and [4,2,1,3] would also be accepted.
Example 2:

Input: nums = [0]
Output: [0]
--------------------------------------------------------------------------------------------
class Solution:
    def sortArrayByParity(self, nums: List[int]) -> List[int]:
        li1=[]
        li2=[]
        for i in range(len(nums)):
            if(nums[i]%2==0):
                li1.append(nums[i])
            else:
                li2.append(nums[i])
        li=li1+li2
        return li
