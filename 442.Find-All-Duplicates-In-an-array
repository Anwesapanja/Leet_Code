Example 1:

Input: nums = [4,3,2,7,8,2,3,1]
Output: [2,3]
Example 2:

Input: nums = [1,1,2]
Output: [1]
Example 3:

Input: nums = [1]
Output: []
----------------------------------------------------------
from collections import Counter
class Solution:
    def findDuplicates(self, nums: List[int]) -> List[int]:
        c1=Counter(nums)
        lii=[]
        liii=[]
        for i in nums:
            if(c1[i]>1):
                lii.append(i)
        li=set(lii)
        liii=list(li)
        return(liii)
