Example 1:

Input: nums = [1,3,4,2,2]
Output: 2
Example 2:

Input: nums = [3,1,3,4,2]
Output: 3
Example 3:

Input: nums = [3,3,3,3,3]
Output: 3
----------------------------------------
class Solution:
    def findDuplicate(self, nums: List[int]) -> int:
        from collections import Counter
        c1=Counter(nums)
        for i in nums:
            if(c1[i]>1):
                return i
