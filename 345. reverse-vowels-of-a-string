Example 1:
Input: s = "IceCreAm"
Output: "AceCreIm"
Explanation:
The vowels in s are ['I', 'e', 'e', 'A']. On reversing the vowels, s becomes "AceCreIm".
Example 2:
Input: s = "leetcode"
Output: "leotcede"
-------------------------------------------------
class Solution:
    def reverseVowels(self, s: str) -> str:
        vowels = set("aeiouAEIOU")
        s1=[]
        for i in s:
            if i in vowels:
                s1.append(i)
        s1.reverse()
        s2=[]
        j=0
        for i in range(len(s)):
            if(s[i] in vowels):
                s2.append(s1[j])
                j+=1
            else:
                s2.append(s[i])
        s3=str(''.join(s2))
        return s3
