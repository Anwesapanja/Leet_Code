Input: matrix = [[1,3,5,7],[10,11,16,20],[23,30,34,60]], target = 3
Output: true

Input: matrix = [[1,3,5,7],[10,11,16,20],[23,30,34,60]], target = 13
Output: false
----------------------------------------------------------------------------
class Solution:
    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:
        n=len(matrix)
        m=len(matrix[0])
        flag=0
        for i in range(n):
            for j in range(m):
                if(target==matrix[i][j]):
                    flag=0
                    return True
                else:
                    flag=1
        if(flag==1):
            return False
